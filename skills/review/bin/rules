#!/usr/bin/env python3
"""The fixed half of review triage: which reviewers a change cannot skip.

    rules [BASE [HEAD]]   # BASE: merge-base with origin's default branch; HEAD: HEAD

Prints JSON: {"files": [...], "lines": N, "required": [...], "nothing": bool, "why": {...}}.
Cheap and certain; the triage agent decides the rest and may only ADD to
"required". "nothing" is true when every changed file is docs or a changelog
entry — no reviewer runs at all.
"""
import json
import re
import subprocess
import sys


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def base():
    if len(sys.argv) > 1:
        return sys.argv[1]
    try:
        head = git("symbolic-ref", "refs/remotes/origin/HEAD").strip().rsplit("/", 1)[-1]
    except subprocess.CalledProcessError:
        head = "main" if git("branch", "-r", "--list", "origin/main").strip() else "master"
    return git("merge-base", "HEAD", f"origin/{head}").strip()


# Changes that need no reviewer: words for people, not code.
DOCS = re.compile(r"(^|/)(changelog/entries/|docs?/)|\.(md|txt)$|(^|/)(README|LICENSE)", re.I)

# Paths and contents that always get a given reviewer, whatever triage thinks.
RULES = {
    "design": [
        (re.compile(r"(^|/)(ui|web|app/javascript|app/views|components?)/|\.(css|scss|tsx|jsx|html|erb|svg)$", re.I), None),
        # Drawn by code rather than markup: the TV daemon's mpv cards (osd-overlay,
        # overlay-add, ASS tags) and PIL images. #80's four film cards had no ui/
        # file, so only the lead noticed they needed a design review (2026-10-19).
        (None, re.compile(r"osd-overlay|overlay-add|ImageDraw|ImageFont|\\\\fs\d+|\{\\\\an\d", re.I)),
    ],
    "security": [
        (re.compile(r"(^|/)(controllers?|config|bin|system)/|Dockerfile|\.env|deploy|routes|auth|session|token|secret|credential|\.(sh|service|timer)$", re.I), None),
        # Contents, whatever the path: shelling out, raw SQL, eval, secrets, devices.
        (None, re.compile(r"subprocess|os\.system|Popen|exec\(|eval\(|system\(|find_by_sql|\.execute\(|"
                          r"API_KEY|SECRET|TOKEN|PASSWORD|Authorization|X-Api-Key|/dev/|sudo|chmod|curl ", re.I)),
    ],
    "quality": [
        (re.compile(r"\.(py|rb|ts|tsx|js|mjs|jsx|go|rs|sh)$|(^|/)bin/", re.I), None),
    ],
}


def main():
    b = base()
    h = sys.argv[2] if len(sys.argv) > 2 else "HEAD"
    files = [f for f in git("diff", "--name-only", f"{b}...{h}").split("\n") if f]
    numstat = git("diff", "--numstat", f"{b}...{h}")
    lines = sum(int(a) + int(d) for a, d, *_ in (l.split("\t") for l in numstat.splitlines())
                if a.isdigit() and d.isdigit())
    added = "\n".join(l[1:] for l in git("diff", "-U0", f"{b}...{h}").splitlines()
                      if l.startswith("+") and not l.startswith("+++"))
    code = [f for f in files if not DOCS.search(f)]
    required, why = [], {}
    for reviewer, rules in RULES.items():
        for path_re, body_re in rules:
            hit = None
            if path_re is not None:
                hit = next((f for f in code if path_re.search(f)), None)
            elif body_re is not None and code:
                m = body_re.search(added)
                hit = m and f"adds {m.group(0).strip()!r}"
            if hit:
                required.append(reviewer)
                why[reviewer] = hit
                break
    print(json.dumps({"base": b, "files": files, "lines": lines, "required": required,
                      "nothing": not code, "why": why}, indent=1))


if __name__ == "__main__":
    main()
