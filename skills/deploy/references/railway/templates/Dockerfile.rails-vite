# Rails API + Vite frontend → one image. Adjust RUBY_VERSION, the two directory
# names (web/, server/), and the apt packages for your DB adapter
# (libpq-dev/libpq5 for Postgres; default-libmysqlclient-dev for MySQL; none for SQLite).

FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM ruby:3.3.6-slim AS gems
WORKDIR /rails
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends build-essential libpq-dev git libyaml-dev && \
    rm -rf /var/lib/apt/lists/*
COPY server/Gemfile server/Gemfile.lock ./
RUN bundle config set --local deployment true && \
    bundle config set --local without "development test" && \
    bundle install --jobs 4 && \
    rm -rf ~/.bundle vendor/bundle/ruby/*/cache

FROM ruby:3.3.6-slim
WORKDIR /rails
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends libpq5 curl tzdata && \
    rm -rf /var/lib/apt/lists/*

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_WITHOUT="development test"

COPY --from=gems /rails/vendor/bundle vendor/bundle
COPY --from=gems /usr/local/bundle /usr/local/bundle
COPY server/ ./
COPY --from=web /web/dist/ public/

# Root on purpose: Railway volumes mount root-owned.
RUN mkdir -p log tmp storage

EXPOSE 3000
CMD ["sh", "-c", "bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p ${PORT:-3000}"]
